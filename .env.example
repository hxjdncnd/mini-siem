# Copy to .env to override the defaults. Never commit the real .env.

# Database password used by Docker Compose.
POSTGRES_PASSWORD=change-me

# If set, every /api request must send this in an X-API-Key header.
MINISIEM_API_KEY=

# Without Docker the backend defaults to a local SQLite file; to point it elsewhere:
# MINISIEM_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/minisiem

# Timezone assumed for syslog lines that carry no UTC offset.
# MINISIEM_DEFAULT_TIMEZONE=America/Detroit
