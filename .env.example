# Copy to .env to override the defaults. Never commit the real .env.

# Database password used by Docker Compose.
POSTGRES_PASSWORD=change-me

# If set, every /api request must send this in an X-API-Key header.
MINISIEM_API_KEY=

# Without Docker the backend defaults to a local SQLite file; to point it elsewhere:
# MINISIEM_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/minisiem

# Timezone assumed for syslog lines that carry no UTC offset.
# MINISIEM_DEFAULT_TIMEZONE=America/Detroit

# Post a message to Slack, Discord or any webhook when a serious alert is first raised. Off when unset.
# MINISIEM_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/XXXX
# Lowest severity that sends a message: low, medium, high or critical.
# MINISIEM_WEBHOOK_MIN_SEVERITY=critical
# Signs each request (X-MiniSIEM-Signature: sha256=<HMAC of the body>) so the receiver can verify it.
# MINISIEM_WEBHOOK_SECRET=
